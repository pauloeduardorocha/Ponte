NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
POSTGRES_PORT=5432
CORS_ORIGIN=http://localhost:5173
POSTGRES_DB=church_management
POSTGRES_USER=church
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql://church:replace-with-a-strong-local-password@localhost:5432/church_management?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# Private filesystem; relative to the API working directory, never serve publicly.
PRIVATE_STORAGE_PATH=./private-storage

# Identificação para relatórios fiscais auxiliares (também editável na tela)
CHURCH_NAME=
CHURCH_TAX_ID=
CHURCH_ADDRESS=
