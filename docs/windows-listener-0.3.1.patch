new file mode 100644
--- /dev/null
+++ b/audience.test.cjs
@@ -0,0 +1,35 @@
+const test = require('node:test'), assert = require('node:assert/strict'), vm = require('node:vm'), fs = require('node:fs');
+function player(play = async () => {}) {
+  const handlers = {}, actions = {}, audio = { src: '', pause() { handlers.pause?.(); }, removeAttribute() { this.src = ''; }, load() { this.loads = (this.loads || 0) + 1; }, play, addEventListener(name, handler) { handlers[name] = handler; } };
+  const button = {}, status = {}, navigator = { mediaSession: { setActionHandler(name, handler) { actions[name] = handler; } } };
+  const elements = { radio: audio, listen: button, 'radio-status': status };
+  vm.runInNewContext(fs.readFileSync(__dirname + '/radio.js', 'utf8'), { document: { getElementById: id => elements[id] }, location: { pathname: '/listen/room' }, navigator, window: { addEventListener() {} } });
+  return { audio, button, status, actions, handlers, navigator };
+}
+test('one native player starts on a gesture, pauses and resumes from a fresh live connection', async () => {
+  let plays = 0; const p = player(async () => { plays++; });
+  assert.equal(p.audio.src, '', 'no audio or network request before user gesture');
+  p.button.onclick(); await Promise.resolve(); p.handlers.playing();
+  assert.equal(p.audio.src, '/audio/room.mp3'); assert.equal(p.button.textContent, 'Pausar áudio');
+  p.button.onclick(); assert.equal(p.audio.src, ''); assert.match(p.status.textContent, /texto continua/);
+  p.button.onclick(); await Promise.resolve(); p.handlers.playing();
+  assert.equal(plays, 2); assert.equal(p.audio.loads, 3); assert.equal(p.navigator.mediaSession.playbackState, 'playing');
+});
+test('screen controls use the same pause and fresh-live resume actions', async () => {
+  const p = player(); p.actions.play(); await Promise.resolve(); p.handlers.playing();
+  p.actions.pause(); assert.equal(p.audio.src, '');
+  p.actions.play(); await Promise.resolve(); assert.equal(p.audio.src, '/audio/room.mp3');
+  p.actions.stop(); assert.equal(p.navigator.mediaSession.playbackState, 'paused');
+});
+test('blocked playback and stream failures leave a usable retry button', async () => {
+  const p = player(async () => { throw Error('autoplay denied'); });
+  p.button.onclick(); await new Promise(resolve => setImmediate(resolve));
+  assert.equal(p.button.disabled, false); assert.match(p.status.textContent, /Não foi possível ouvir/);
+  p.handlers.error(); assert.equal(p.button.textContent, 'Retomar ao vivo');
+  p.handlers.ended(); assert.match(p.status.textContent, /terminou/);
+});
+test('late play rejection cannot overwrite a newer pause action', async () => {
+  let reject; const p = player(() => new Promise((_, fail) => { reject = fail; }));
+  p.actions.play(); p.actions.pause(); reject(Error('aborted')); await new Promise(resolve => setImmediate(resolve));
+  assert.match(p.status.textContent, /pausado/); assert.equal(p.button.disabled, false);
+});
