+      running.once('error', reject);
+      running.stdout.on('data', bytes => { if (bytes.toString().includes('function')) { clearTimeout(timeout); resolve(); } });
+      running.once('exit', code => { clearTimeout(timeout); reject(Error('runtime exited: ' + code)); });
+    });
