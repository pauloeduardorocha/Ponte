diff --git a/update-checker.cjs b/update-checker.cjs
new file mode 100644
--- /dev/null
+++ b/update-checker.cjs
@@ -0,0 +1,72 @@
+const RELEASES_URL = 'https://api.github.com/repos/pauloeduardorocha/Ponte/releases?per_page=100';
+const REPOSITORY_URL = 'https://github.com/pauloeduardorocha/Ponte';
+const ASSET_NAME = 'Ponte-Traducao-Windows.zip';
+function parseVersion(version) {
+  if (typeof version !== 'string' || !/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/.test(version)) return null;
+  const parts = version.split('.').map(Number);
+  return parts.every(Number.isSafeInteger) ? parts : null;
+}
+function compareVersions(left, right) {
+  const a = parseVersion(left), b = parseVersion(right);
+  if (!a || !b) throw new Error('Versão inválida.');
+  for (let i = 0; i < 3; i++) if (a[i] !== b[i]) return a[i] > b[i] ? 1 : -1;
+  return 0;
+}
+function findUpdate(releases, installedVersion) {
+  if (!Array.isArray(releases)) throw new Error('Resposta de versões inválida.');
+  if (!parseVersion(installedVersion)) throw new Error('Versão instalada inválida.');
+  let latest = null;
+  for (const release of releases) {
+    if (!release || release.draft || release.prerelease || typeof release.tag_name !== 'string') continue;
+    const version = release.tag_name.replace(/^ponte-traducao-v/, '');
+    if (release.tag_name !== `ponte-traducao-v${version}` || !parseVersion(version)) continue;
+    if (compareVersions(version, installedVersion) <= 0 || (latest && compareVersions(version, latest.version) <= 0)) continue;
+    const downloadUrl = `${REPOSITORY_URL}/releases/download/${release.tag_name}/${ASSET_NAME}`;
+    const asset = Array.isArray(release.assets) && release.assets.find(item => item && item.name === ASSET_NAME && item.state === 'uploaded' && item.size > 0 && item.browser_download_url === downloadUrl);
+    if (asset) latest = { version, downloadUrl };
+  }
+  return latest;
+}
+async function fetchUpdate(installedVersion, fetchImpl = fetch) {
+  const releases = [], signal = AbortSignal.timeout(8000);
+  for (let page = 1; page <= 5; page++) {
+    const response = await fetchImpl(`${RELEASES_URL}&page=${page}`, {
+      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'Ponte-Traducao-update-check', 'X-GitHub-Api-Version': '2022-11-28' },
+      signal, redirect: 'error',
+    });
+    if (!response.ok) throw new Error(`Não foi possível consultar as versões (HTTP ${response.status}).`);
+    const batch = await response.json();
+    if (!Array.isArray(batch)) throw new Error('Resposta de versões inválida.');
+    releases.push(...batch);
+    if (batch.length < 100) return findUpdate(releases, installedVersion);
+  }
+  throw new Error('Não foi possível concluir a consulta de versões. Tente novamente mais tarde.');
+}
+function createUpdateChecker({ version, getWindow, dialog, shell, fetchImpl = fetch }) {
+  let checking = null;
+  return function check({ manual = false } = {}) {
+    if (checking) return checking;
+    checking = (async () => {
+      try {
+        const update = await fetchUpdate(version, fetchImpl), win = getWindow();
+        if (!win || win.isDestroyed()) return;
+        if (!update) {
+          if (manual) await dialog.showMessageBox(win, { type: 'info', title: 'Atualizações do Ponte', message: `Você está na versão ${version}.`, detail: 'Não há uma versão mais recente do aplicativo de tradução disponível.', buttons: ['OK'] });
+          return;
+        }
+        const result = await dialog.showMessageBox(win, {
+          type: 'info', title: 'Atualização disponível', message: `Ponte · Tradução ${update.version} disponível`,
+          detail: `Versão instalada: ${version}.\n\nBaixe o ZIP, extraia e execute Instalar.cmd. A instalação substitui a versão anterior na mesma pasta e mantém os atalhos. Feche o aplicativo antes de instalar, após terminar a tradução.`,
+          buttons: ['Baixar atualização', 'Agora não'], defaultId: 0, cancelId: 1, noLink: true,
+        });
+        if (result.response === 0 && !win.isDestroyed()) await shell.openExternal(update.downloadUrl);
+      } catch {
+        const win = getWindow();
+        if (manual && win && !win.isDestroyed()) await dialog.showMessageBox(win, { type: 'warning', title: 'Atualizações do Ponte', message: 'Não foi possível verificar as atualizações.', detail: 'Confira a conexão com a internet e tente novamente em Ajuda → Verificar atualizações. Você pode continuar usando o aplicativo.', buttons: ['OK'] });
+        // Startup checks must never prevent an offline launch or interrupt translation.
+      }
+    })().finally(() => { checking = null; });
+    return checking;
+  };
+}
+module.exports = { compareVersions, findUpdate, fetchUpdate, createUpdateChecker };
diff --git a/update-checker.test.cjs b/update-checker.test.cjs
new file mode 100644
--- /dev/null
+++ b/update-checker.test.cjs
@@ -0,0 +1,88 @@
+const test = require('node:test'), assert = require('node:assert/strict');
+const { compareVersions, findUpdate, fetchUpdate, createUpdateChecker } = require('./update-checker.cjs');
+function release(version, overrides = {}) {
+  const tag = `ponte-traducao-v${version}`;
+  return { tag_name: tag, draft: false, prerelease: false, assets: [{ name: 'Ponte-Traducao-Windows.zip', state: 'uploaded', size: 100, browser_download_url: `https://github.com/pauloeduardorocha/Ponte/releases/download/${tag}/Ponte-Traducao-Windows.zip` }], ...overrides };
+}
+function harness(releases, options = {}) {
+  const shown = [], opened = [], calls = [];
+  const win = { isDestroyed: () => Boolean(options.destroyed) };
+  const check = createUpdateChecker({ version: '0.3.2', getWindow: () => win,
+    dialog: { showMessageBox: async (_, value) => { shown.push(value); return { response: options.response ?? 0 }; } },
+    shell: { openExternal: async url => { opened.push(url); } },
+    fetchImpl: async (url, init) => { calls.push({ url, init }); if (options.error) throw Error('offline'); return { ok: true, json: async () => releases }; },
+  });
+  return { check, shown, opened, calls };
+}
+test('versions compare numerically and reject malformed versions', () => {
+  assert.equal(compareVersions('0.10.0', '0.9.99'), 1);
+  assert.equal(compareVersions('1.0.0', '0.99.99'), 1);
+  assert.equal(compareVersions('0.3.2', '0.3.2'), 0);
+  for (const bad of ['v1.0.0', '1.2', '01.2.3', '1.2.3-beta', '9007199254740992.0.0']) assert.throws(() => compareVersions(bad, '1.0.0'));
+});
+test('only newer complete stable translation releases count, regardless of ordering', () => {
+  const candidates = [release('0.10.0'), release('1.0.0', { draft: true }), release('2.0.0', { prerelease: true }), release('9.0.0', { assets: [] }), release('0.4.0'), release('0.3.2'), release('0.3.1'), release('5.0.0', { tag_name: 'v5.0.0' })];
+  assert.equal(findUpdate(candidates, '0.3.2').version, '0.10.0');
+  assert.equal(findUpdate([release('0.3.2'), release('0.3.1')], '0.3.2'), null);
+  assert.throws(() => findUpdate({}, '0.3.2'));
+});
+test('untrusted download URLs, incomplete uploads and empty assets are ignored', () => {
+  for (const url of ['file:///C:/Windows/test.exe', 'https://evil.example/setup.zip', 'https://github.com/other/repo/releases/download/v1/file.zip', 'javascript:alert(1)']) {
+    const r = release('0.4.0'); r.assets[0].browser_download_url = url;
+    assert.equal(findUpdate([r], '0.3.2'), null);
+  }
+  for (const changes of [{ state: 'new' }, { size: 0 }]) { const r = release('0.4.0'); Object.assign(r.assets[0], changes); assert.equal(findUpdate([r], '0.3.2'), null); }
+});
+test('startup checks once and opens the exact release download only when selected', async () => {
+  const h = harness([release('0.4.0')]);
+  const one = h.check(); assert.equal(h.check(), one); await one;
+  assert.equal(h.calls.length, 1); assert.equal(h.shown.length, 1);
+  assert.match(h.shown[0].detail, /Instalar.cmd/);
+  assert.deepEqual(h.opened, ['https://github.com/pauloeduardorocha/Ponte/releases/download/ponte-traducao-v0.4.0/Ponte-Traducao-Windows.zip']);
+  assert.equal(h.calls[0].init.redirect, 'error'); assert.ok(h.calls[0].init.signal);
+  const deferred = harness([release('0.4.0')], { response: 1 }); await deferred.check(); assert.equal(deferred.opened.length, 0);
+});
+test('offline and current startup checks stay quiet; manual checks explain the result and retry', async () => {
+  for (const options of [{}, { error: true }]) {
+    const h = harness([release('0.3.2')], options); await h.check(); assert.equal(h.shown.length, 0);
+    await h.check({ manual: true }); assert.equal(h.calls.length, 2); assert.equal(h.shown.length, 1);
+    assert.match(h.shown[0].message, options.error ? /Não foi possível/ : /0.3.2/);
+  }
+  const closed = harness([release('0.4.0')], { destroyed: true }); await closed.check(); assert.equal(closed.shown.length, 0);
+});
+test('HTTP failures and malformed responses reject rather than pretending to be up to date', async () => {
+  await assert.rejects(fetchUpdate('0.3.2', async () => ({ ok: false, status: 403 })), /HTTP 403/);
+  await assert.rejects(fetchUpdate('0.3.2', async () => ({ ok: true, json: async () => ({}) })), /inválida/);
+});
+test('pagination finds releases beyond the first page', async () => {
+  const urls = [];
+  const update = await fetchUpdate('0.3.2', async url => { urls.push(url); return { ok: true, json: async () => urls.length === 1 ? Array.from({ length: 100 }, () => ({ tag_name: 'web-release' })) : [release('0.4.0')] }; });
+  assert.equal(update.version, '0.4.0'); assert.match(urls[1], /page=2$/);
+});
+const vm = require('node:vm'), fs = require('node:fs');
+test('desktop startup triggers a non-blocking check and exposes a manual menu action', async () => {
+  let ready, menu, options, loaded = false;
+  const checks = [], windows = [], pending = new Promise(() => {});
+  class Window {
+    constructor(settings) { options = settings; windows.push(this); this.webContents = { setWindowOpenHandler() {}, on() {} }; }
+    async loadURL() { loaded = true; }
+    on() {}
+  }
+  const electron = { app: { whenReady: () => ({ then: callback => { ready = callback; } }), on() {} }, BrowserWindow: Window,
+    session: { defaultSession: { setPermissionRequestHandler() {} } }, dialog: {}, shell: {},
+    Menu: { buildFromTemplate: template => template, setApplicationMenu: value => { menu = value; } },
+  };
+  vm.runInNewContext(fs.readFileSync(__dirname + '/main.cjs', 'utf8'), {
+    __dirname, require: name => {
+      if (name === 'electron') return electron;
+      if (name === './server.cjs') return { createTranslationServer: () => ({ listen: async () => ({ presenterUrl: 'http://localhost:3210/presenter#test' }) }) };
+      if (name === './update-checker.cjs') return { createUpdateChecker: config => { assert.equal(config.version, '0.3.2'); return settings => { checks.push(settings); return pending; }; } };
+      return require(name);
+    },
+  });
+  await ready();
+  assert.equal(loaded, true); assert.equal(windows.length, 1); assert.match(options.title, /0.3.2/);
+  assert.equal(checks.length, 1, 'startup checks once without waiting for the network');
+  menu.find(item => item.label === 'Ajuda').submenu[0].click();
+  assert.equal(checks[1].manual, true);
+});
diff --git a/install-windows.ps1 b/install-windows.ps1
new file mode 100644
--- /dev/null
+++ b/install-windows.ps1
@@ -0,0 +1,91 @@
+﻿param(
+    [string]$SourceDirectory = $PSScriptRoot,
+    [switch]$NoLaunch,
+    [switch]$NoShortcuts
+)
+$ErrorActionPreference = 'Stop'
+$stage = $null
+$previous = $null
+$installed = $false
+function Remove-InstallerFolder([string]$Folder) {
+    if (-not $Folder -or -not (Test-Path -LiteralPath $Folder)) { return }
+    $resolved = [System.IO.Path]::GetFullPath($Folder)
+    if ([System.IO.Path]::GetDirectoryName($resolved) -ne $installParent -or
+        [System.IO.Path]::GetFileName($resolved) -notmatch '^\.Ponte-Traducao-(install|previous)-[a-f0-9]{32}$') {
+        throw 'Pasta temporária de instalação inválida.'
+    }
+    Remove-Item -LiteralPath $resolved -Recurse -Force
+}
+try {
+    if (-not $env:LOCALAPPDATA) { throw 'Não foi possível localizar a pasta de aplicativos deste usuário.' }
+    $installParent = [System.IO.Path]::GetFullPath($env:LOCALAPPDATA).TrimEnd('\')
+    if (-not [System.IO.Path]::IsPathRooted($installParent) -or $installParent -eq [System.IO.Path]::GetPathRoot($installParent).TrimEnd('\')) {
+        throw 'A pasta de aplicativos deste usuário é inválida.'
+    }
+    $target = [System.IO.Path]::GetFullPath((Join-Path $installParent 'Ponte-Traducao'))
+    if ([System.IO.Path]::GetDirectoryName($target) -ne $installParent) { throw 'Destino de instalação inválido.' }
+    $source = (Resolve-Path -LiteralPath $SourceDirectory).Path
+    $sourcePackage = Join-Path $source 'resources\app\package.json'
+    if (-not (Test-Path -LiteralPath (Join-Path $source 'Ponte-Traducao.exe')) -or -not (Test-Path -LiteralPath $sourcePackage)) {
+        throw 'Extraia o ZIP inteiro antes de executar Instalar.cmd. Não separe os arquivos do pacote.'
+    }
+    $package = Get-Content -Raw -LiteralPath $sourcePackage | ConvertFrom-Json
+    if ($package.name -ne 'ponte-traducao' -or $package.version -notmatch '^\d+\.\d+\.\d+$') { throw 'Este pacote do Ponte não é válido.' }
+    # Never replace a running presenter: stopping it could interrupt the congregation.
+    if (Get-Process -Name 'Ponte-Traducao' -ErrorAction SilentlyContinue) {
+        throw 'Feche o aplicativo Ponte - Tradução antes de instalar. Se houver um culto em andamento, aguarde a tradução terminar e execute Instalar.cmd novamente.'
+    }
+    if (Test-Path -LiteralPath $target) {
+        $existingPackage = Join-Path $target 'resources\app\package.json'
+        if (-not (Test-Path -LiteralPath $existingPackage)) { throw 'A pasta de destino não contém uma instalação reconhecida do Ponte. Nenhum arquivo foi substituído.' }
+        $existing = Get-Content -Raw -LiteralPath $existingPackage | ConvertFrom-Json
+        if ($existing.name -ne 'ponte-traducao') { throw 'A pasta de destino pertence a outro aplicativo. Nenhum arquivo foi substituído.' }
+        if ([version]$existing.version -gt [version]$package.version) { throw 'Uma versão mais recente já está instalada. Use o pacote mais recente.' }
+    }
+    if ($source -ne $target) {
+        New-Item -ItemType Directory -Path $installParent -Force | Out-Null
+        $stage = Join-Path $installParent ('.Ponte-Traducao-install-' + [guid]::NewGuid().ToString('N'))
+        New-Item -ItemType Directory -Path $stage | Out-Null
+        foreach ($item in Get-ChildItem -LiteralPath $source -Force) {
+            Copy-Item -LiteralPath $item.FullName -Destination $stage -Recurse -Force
+        }
+        if (Test-Path -LiteralPath $target) {
+            $previous = Join-Path $installParent ('.Ponte-Traducao-previous-' + [guid]::NewGuid().ToString('N'))
+            Move-Item -LiteralPath $target -Destination $previous
+        }
+        try {
+            Move-Item -LiteralPath $stage -Destination $target
+            $stage = $null
+        } catch {
+            if ($previous -and -not (Test-Path -LiteralPath $target)) {
+                Move-Item -LiteralPath $previous -Destination $target
+                $previous = $null
+            }
+            throw
+        }
+    }
+    $installed = $true
+    # App data lives outside this directory. Reusing the same target also reuses the shortcuts.
+    if (-not $NoShortcuts) {
+        $shortcutShell = New-Object -ComObject WScript.Shell
+        foreach ($folder in @([Environment]::GetFolderPath('DesktopDirectory'), [Environment]::GetFolderPath('Programs'))) {
+            if (-not $folder) { continue }
+            New-Item -ItemType Directory -Path $folder -Force | Out-Null
+            $shortcut = $shortcutShell.CreateShortcut((Join-Path $folder 'Ponte - Tradução.lnk'))
+            $shortcut.TargetPath = Join-Path $target 'Ponte-Traducao.exe'
+            $shortcut.WorkingDirectory = $target
+            $shortcut.Description = 'Ponte - Tradução ao vivo'
+            $shortcut.Save()
+        }
+    }
+    Remove-InstallerFolder $previous
+    Write-Host ('Ponte - Tradução ' + $package.version + ' instalado em ' + $target)
+    Write-Host 'As próximas instalações substituirão esta versão no mesmo local.'
+    if (-not $NoLaunch) { Start-Process -FilePath (Join-Path $target 'Ponte-Traducao.exe') -WorkingDirectory $target -WindowStyle Normal }
+} catch {
+    Write-Host ('Não foi possível concluir a instalação: ' + $_.Exception.Message) -ForegroundColor Red
+    if ($installed) { Write-Host ('O aplicativo já foi copiado. Você pode abri-lo em ' + $target) }
+    exit 1
+} finally {
+    Remove-InstallerFolder $stage
+}
