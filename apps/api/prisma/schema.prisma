generator client {
  provider = "prisma-client-js"
}

// Optional persistent private attachments for serverless hosting.
model PrivateFile {
  id        String   @id @db.Uuid
  content   Bytes
  createdAt DateTime @default(now())

  @@map("private_files")
}

model Visitor {
  createdByUserId   String?             @db.Uuid
  creator           User?               @relation("VisitorCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  firstName         String              @default("") @db.VarChar(60)
  lastName          String              @default("") @db.VarChar(60)
  birthDate         DateTime?           @db.Date
  gender            String?             @db.VarChar(30)
  howDidYouHear     String?             @db.VarChar(200)
  invitedByMemberId String?             @db.Uuid
  invitedBy         Member?             @relation("VisitorInviter", fields: [invitedByMemberId], references: [id], onDelete: Restrict)
  memberId          String?             @unique @db.Uuid
  member            Member?             @relation("ConvertedVisitor", fields: [memberId], references: [id], onDelete: Restrict)
  convertedByUserId String?             @db.Uuid
  convertedBy       User?               @relation("VisitorConverter", fields: [convertedByUserId], references: [id], onDelete: Restrict)
  convertedAt       DateTime?
  followUps         FollowUp[]
  registrations     EventRegistration[]
  attendances       Attendance[]
  notifications     Notification[]
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(120)
  email             String?             @db.VarChar(320)
  phone             String?             @db.VarChar(32)
  visitedAt         DateTime            @db.Date
  status            String              @default("NEW") @db.VarChar(20)
  notes             String?             @db.VarChar(2000)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, visitedAt])
  @@index([createdByUserId], map: "visitors_creator_idx")
  @@map("visitors")
}

model CommunityEvent {
  managerAssignments EventManagerAssignment[]
  tickets            EventTicket[]
  coupons            EventCoupon[]
  payments           EventPayment[]
  sessions           EventSession[]
  publishedAt        DateTime?

  type                 String              @default("OTHER") @db.VarChar(30)
  endsAt               DateTime?           @db.Timestamptz(6)
  capacity             Int?
  isPaid               Boolean             @default(false)
  registrationRequired Boolean             @default(false)
  active               Boolean             @default(true)
  createdByUserId      String?             @db.Uuid
  creator              User?               @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  ministryId           String?             @db.Uuid
  ministry             Ministry?           @relation(fields: [ministryId], references: [id], onDelete: Restrict)
  smallGroupId         String?             @db.Uuid
  smallGroup           SmallGroup?         @relation(fields: [smallGroupId], references: [id], onDelete: Restrict)
  registrations        EventRegistration[]
  schedules            VolunteerSchedule[]
  attendances          Attendance[]
  id                   String              @id @default(uuid()) @db.Uuid
  name                 String              @db.VarChar(160)
  startsAt             DateTime            @db.Timestamptz(6)
  location             String              @db.VarChar(200)
  status               String              @default("SCHEDULED") @db.VarChar(20)
  description          String?             @db.VarChar(2000)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status, startsAt])
  @@map("community_events")
}

model RateLimitBucket {
  key          String    @id @db.VarChar(64)
  hits         Int
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@index([expiresAt], map: "rate_limit_expiry_idx")
  @@map("rate_limit_buckets")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  managedEvents         EventManagerAssignment[] @relation("EventManager")
  assignedEventManagers EventManagerAssignment[] @relation("EventAssigner")

  invoiceImports        InvoiceImport[]       @relation("InvoiceUploader")
  invoiceAssociations   FinancialInvoice[]    @relation("InvoiceAssociator")
  createdVisitors       Visitor[]             @relation("VisitorCreator")
  createdNotifications  Notification[]        @relation("NotificationCreator")
  convertedVisitors     Visitor[]             @relation("VisitorConverter")
  followUps             FollowUp[]
  interactions          FollowUpInteraction[]
  createdEvents         CommunityEvent[]      @relation("EventCreator")
  registeredAttendances Attendance[]
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String                @default("") @db.VarChar(120)
  email                 String                @unique @db.VarChar(320)
  passwordHash          String                @map("password_hash") @db.VarChar(255)
  status                UserStatus            @default(INVITED)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz(6)
  memberId              String?               @unique @map("member_id") @db.Uuid
  member                Member?               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  userRoles             UserRole[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordReset[]
  bankClassifications   BankTransaction[]     @relation("BankClassifier")
  bankAssociations      BankTransaction[]     @relation("BankAssociator")
  bankDuplicateReviews  BankTransaction[]     @relation("BankDuplicateReviewer")
  bankUploads           BankImport[]          @relation("BankUploader")
  bankConfirmations     BankImport[]          @relation("BankConfirmer")
  bankReconciliations   BankReconciliation[]  @relation("BankReconciler")
  bankUndoActions       BankReconciliation[]  @relation("BankUndoer")
  financialUploads      FinancialAttachment[] @relation("AttachmentUploader")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  displayName String? @map("display_name") @db.VarChar(120)

  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(64)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_resets")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

model Member {
  invitedVisitors     Visitor[]             @relation("VisitorInviter")
  convertedVisitor    Visitor?              @relation("ConvertedVisitor")
  followUps           FollowUp[]
  ledGroups           SmallGroup[]          @relation("GroupLeader")
  coLedGroups         SmallGroup[]          @relation("GroupCoLeader")
  hostedGroups        SmallGroup[]          @relation("GroupHost")
  groupMemberships    SmallGroupMember[]
  ledMinistries       Ministry[]            @relation("MinistryLeader")
  ministryMemberships MinistryMember[]
  eventRegistrations  EventRegistration[]
  assignments         VolunteerAssignment[]
  attendances         Attendance[]
  notifications       Notification[]
  id                  String                @id @default(uuid()) @db.Uuid
  name                String                @db.VarChar(120)
  email               String?               @db.VarChar(320)
  phone               String?               @db.VarChar(32)
  status              MemberStatus          @default(ACTIVE)
  birthDate           DateTime?             @map("birth_date") @db.Date
  notes               String?               @db.VarChar(2000)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User?
  privacyRequests     PrivacyRequest[]
  consents            MemberConsent[]
  anonymizedAt        DateTime?             @map("anonymized_at") @db.Timestamptz(6)
  legalHold           Boolean               @default(false) @map("legal_hold")
  incomes             Income[]
  contributions       Contribution[]
  loans               Loan[]
  reservations        Reservation[]
  bankTransactions    BankTransaction[]

  @@index([status, name])
  @@map("members")
}

enum CopyStatus {
  AVAILABLE
  LOANED
  RESERVED
  MAINTENANCE
  LOST
  DISPOSED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
  CANCELLED
}

enum ReservationStatus {
  WAITING
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

enum FineStatus {
  OPEN
  PAID
  FORGIVEN
  CANCELLED
}

model Book {
  id           String        @id @default(uuid()) @db.Uuid
  title        String        @db.VarChar(200)
  subtitle     String?       @db.VarChar(200)
  author       String        @db.VarChar(200)
  isbn         String?       @unique @db.VarChar(32)
  publisher    String?       @db.VarChar(200)
  edition      String?       @db.VarChar(80)
  year         Int?
  language     String        @default("pt") @db.VarChar(80)
  description  String?       @db.Text
  pages        Int?
  cover        String?       @db.VarChar(2000)
  category     String?       @db.VarChar(120)
  keywords     String[]      @default([])
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  copies       BookCopy[]
  reservations Reservation[]

  @@index([category, title])
  @@map("library_books")
}

model BookCopy {
  id           String        @id @default(uuid()) @db.Uuid
  bookId       String        @db.Uuid
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  assetCode    String        @unique @db.VarChar(100)
  barcode      String?       @unique @db.VarChar(100)
  qrCode       String?       @unique @db.VarChar(200)
  condition    String        @default("GOOD") @db.VarChar(120)
  location     String        @db.VarChar(200)
  status       CopyStatus    @default(AVAILABLE)
  acquiredAt   DateTime?     @db.Timestamptz(6)
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  loans        Loan[]
  reservations Reservation[]

  @@index([bookId, status])
  @@map("library_copies")
}

model Loan {
  id           String     @id @default(uuid()) @db.Uuid
  memberId     String     @db.Uuid
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  bookCopyId   String     @db.Uuid
  bookCopy     BookCopy   @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  borrowedAt   DateTime   @default(now()) @db.Timestamptz(6)
  dueAt        DateTime   @db.Timestamptz(6)
  returnedAt   DateTime?  @db.Timestamptz(6)
  status       LoanStatus @default(ACTIVE)
  renewedCount Int        @default(0)
  createdBy    String     @db.Uuid
  returnedBy   String?    @db.Uuid
  observations String?    @db.Text
  graceDays    Int
  dailyFine    Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  fine         Fine?

  @@index([memberId, status])
  @@index([status, dueAt])
  @@map("library_loans")
}

model LibrarySettings {
  id              Int      @id @default(1)
  defaultLoanDays Int      @default(14)
  maxBooks        Int      @default(3)
  maxRenewals     Int      @default(2)
  graceDays       Int      @default(0)
  dailyFine       Decimal  @default(1) @db.Decimal(12, 2)
  blockOverdue    Boolean  @default(true)
  holdDays        Int      @default(2)
  reservationDays Int      @default(30)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@map("library_settings")
}

model Fine {
  id          String           @id @default(uuid()) @db.Uuid
  loanId      String           @unique @db.Uuid
  loan        Loan             @relation(fields: [loanId], references: [id], onDelete: Restrict)
  amount      Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  status      FineStatus       @default(OPEN)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  payments    FinePayment[]
  adjustments FineAdjustment[]

  @@map("library_fines")
}

model FinePayment {
  id             String   @id @default(uuid()) @db.Uuid
  fineId         String   @db.Uuid
  fine           Fine     @relation(fields: [fineId], references: [id], onDelete: Restrict)
  amount         Decimal  @db.Decimal(12, 2)
  idempotencyKey String   @unique @db.Uuid
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@map("library_fine_payments")
}

model FineAdjustment {
  id            String   @id @default(uuid()) @db.Uuid
  fineId        String   @db.Uuid
  fine          Fine     @relation(fields: [fineId], references: [id], onDelete: Restrict)
  kind          String   @db.VarChar(20)
  amount        Decimal  @db.Decimal(12, 2)
  justification String   @db.VarChar(2000)
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@map("library_fine_adjustments")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  bookId     String            @db.Uuid
  book       Book              @relation(fields: [bookId], references: [id], onDelete: Restrict)
  memberId   String            @db.Uuid
  member     Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  bookCopyId String?           @db.Uuid
  bookCopy   BookCopy?         @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  status     ReservationStatus @default(WAITING)
  expiresAt  DateTime          @db.Timestamptz(6)
  readyAt    DateTime?         @db.Timestamptz(6)
  holdUntil  DateTime?         @db.Timestamptz(6)
  createdBy  String            @db.Uuid
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)

  @@index([bookId, status, createdAt])
  @@map("library_reservations")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(120)
  entity        String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.VarChar(100)
  metadata      Json?
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(1024)
  transactionId String?  @map("transaction_id") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_at_idx")
  @@index([transactionId, entity, entityId], map: "audit_logs_transaction_entity_idx")
  @@map("audit_logs")
}

enum FinancialKind {
  INCOME
  EXPENSE
}

enum FinancialStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ContributionType {
  TITHE
  OFFERING
  DONATION
  OTHER
}

model FinancialCategory {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @db.VarChar(120)
  kind             FinancialKind
  parentId         String?             @db.Uuid
  parent           FinancialCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         FinancialCategory[] @relation("CategoryTree")
  incomes          Income[]
  expenses         Expense[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  bankTransactions BankTransaction[]

  @@index([parentId])
  @@map("financial_categories")
}

model BankAccount {
  id             String       @id @default(uuid()) @db.Uuid
  bank           String       @db.VarChar(120)
  name           String       @db.VarChar(120)
  branch         String?      @db.VarChar(40)
  account        String?      @db.VarChar(80)
  iban           String?      @db.VarChar(34)
  currency       String       @db.Char(3)
  openingBalance Decimal      @default(0) @db.Decimal(14, 2)
  status         MemberStatus @default(ACTIVE)
  incomes        Income[]
  expenses       Expense[]
  imports        BankImport[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("bank_accounts")
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(120)
  taxId            String?           @db.VarChar(40)
  email            String?           @db.VarChar(320)
  phone            String?           @db.VarChar(32)
  expenses         Expense[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bankTransactions BankTransaction[]

  @@map("suppliers")
}

model Income {
  id                String               @id @default(uuid()) @db.Uuid
  amount            Decimal              @db.Decimal(14, 2)
  date              DateTime             @db.Date
  categoryId        String               @db.Uuid
  category          FinancialCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accountId         String               @db.Uuid
  account           BankAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  description       String               @db.VarChar(2000)
  origin            String               @db.VarChar(200)
  memberId          String?              @db.Uuid
  member            Member?              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  costCenter        String?              @db.VarChar(120)
  reference         String?              @db.VarChar(200)
  status            FinancialStatus      @default(PENDING)
  bankTransactionId String?              @db.Uuid
  bankTransaction   BankTransaction?     @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  reconciliations   BankReconciliation[]
  contribution      Contribution?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([date, status])
  @@index([accountId, date], map: "incomes_account_date_idx")
  @@index([memberId], map: "incomes_member_idx")
  @@map("incomes")
}

model Expense {
  id                String                @id @default(uuid()) @db.Uuid
  amount            Decimal               @db.Decimal(14, 2)
  date              DateTime              @db.Date
  dueDate           DateTime              @db.Date
  paidAt            DateTime?             @db.Date
  categoryId        String                @db.Uuid
  category          FinancialCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplierId        String?               @db.Uuid
  supplier          Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  accountId         String                @db.Uuid
  account           BankAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter        String?               @db.VarChar(120)
  description       String                @db.VarChar(2000)
  document          String?               @db.VarChar(200)
  status            FinancialStatus       @default(PENDING)
  bankTransactionId String?               @db.Uuid
  bankTransaction   BankTransaction?      @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  reconciliations   BankReconciliation[]
  attachments       FinancialAttachment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([date, status])
  @@index([accountId, paidAt], map: "expenses_account_payment_idx")
  @@index([supplierId], map: "expenses_supplier_idx")
  @@map("expenses")
}

model Contribution {
  id        String           @id @default(uuid()) @db.Uuid
  memberId  String           @db.Uuid
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  incomeId  String           @unique @db.Uuid
  income    Income           @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  type      ContributionType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([memberId])
  @@map("contributions")
}

model FinancialAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  expenseId  String   @db.Uuid
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  storageKey String   @unique @db.VarChar(100)
  filename   String   @db.VarChar(255)
  mime       String   @db.VarChar(100)
  size       Int
  uploadedBy String   @db.Uuid
  createdAt  DateTime @default(now())
  uploader   User     @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "attachment_uploaded_by_fk")

  @@index([expenseId])
  @@map("financial_attachments")
}

model BankImport {
  id           String            @id @default(uuid()) @db.Uuid
  accountId    String            @db.Uuid
  account      BankAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  storageKey   String            @unique @db.VarChar(100)
  filename     String            @db.VarChar(255)
  status       BankImportStatus  @default(UPLOADED)
  format       String?           @db.VarChar(10)
  mime         String?           @db.VarChar(100)
  size         Int?
  fileHash     String?           @db.VarChar(64)
  uploadedBy   String?           @db.Uuid
  confirmedBy  String?           @db.Uuid
  confirmedAt  DateTime?
  error        String?           @db.VarChar(2000)
  updatedAt    DateTime          @default(now()) @updatedAt
  transactions BankTransaction[]
  createdAt    DateTime          @default(now())
  uploader     User?             @relation("BankUploader", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_uploaded_by_fk")
  confirmer    User?             @relation("BankConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_confirmed_by_fk")

  @@index([accountId, createdAt])
  @@map("bank_imports")
}

model BankTransaction {
  id                  String                @id @default(uuid()) @db.Uuid
  importId            String                @db.Uuid
  import              BankImport            @relation(fields: [importId], references: [id], onDelete: Restrict)
  amount              Decimal               @db.Decimal(14, 2)
  date                DateTime              @db.Date
  reference           String                @db.VarChar(200)
  direction           BankDirection         @default(CREDIT)
  description         String                @default("") @db.VarChar(2000)
  bankIdentifier      String?               @db.VarChar(200)
  fingerprint         String?               @db.VarChar(64)
  rowNumber           Int                   @default(0)
  status              BankTransactionStatus @default(PENDING_REVIEW)
  classification      BankClassification?
  categoryId          String?               @db.Uuid
  memberId            String?               @db.Uuid
  supplierId          String?               @db.Uuid
  contributionType    ContributionType?
  associatedBy        String?               @db.Uuid
  associatedAt        DateTime?
  classifiedBy        String?               @db.Uuid
  duplicateReviewedBy String?               @db.Uuid
  duplicateReviewedAt DateTime?
  duplicateReason     String?               @db.VarChar(500)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  incomes             Income[]
  expenses            Expense[]
  reconciliations     BankReconciliation[]
  invoices            FinancialInvoice[]
  category            FinancialCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_category_fk")
  member              Member?               @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_member_fk")
  supplier            Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_supplier_fk")
  classifier          User?                 @relation("BankClassifier", fields: [classifiedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_classified_by_fk")
  associator          User?                 @relation("BankAssociator", fields: [associatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_associated_by_fk")
  duplicateReviewer   User?                 @relation("BankDuplicateReviewer", fields: [duplicateReviewedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_duplicate_by_fk")

  @@index([fingerprint])
  @@index([importId, status])
  @@index([date, status])
  @@index([memberId])
  @@index([categoryId])
  @@index([supplierId])
  @@map("bank_transactions")
}

enum BankImportStatus {
  UPLOADED
  PROCESSING
  READY_FOR_REVIEW
  CONFIRMED
  FAILED
}

enum BankDirection {
  CREDIT
  DEBIT
}

enum BankTransactionStatus {
  PENDING_REVIEW
  CLASSIFIED
  RECONCILED
  REJECTED
  POSSIBLE_DUPLICATE
}

enum BankClassification {
  INCOME
  EXPENSE
  IGNORE
}

model BankReconciliation {
  id                String          @id @default(uuid()) @db.Uuid
  bankTransactionId String          @db.Uuid
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  incomeId          String?         @db.Uuid
  income            Income?         @relation(fields: [incomeId], references: [id], onDelete: Restrict)
  expenseId         String?         @db.Uuid
  expense           Expense?        @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdLedger     Boolean
  active            Boolean         @default(true)
  reconciledBy      String          @db.Uuid
  reconciledAt      DateTime        @default(now())
  undoneBy          String?         @db.Uuid
  undoneAt          DateTime?
  undoReason        String?         @db.VarChar(500)
  reconciler        User            @relation("BankReconciler", fields: [reconciledBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_reconciled_by_fk")
  undoer            User?           @relation("BankUndoer", fields: [undoneBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bank_undone_by_fk")

  @@index([bankTransactionId, active])
  @@map("bank_reconciliations")
}

