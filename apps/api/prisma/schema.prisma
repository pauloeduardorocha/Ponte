generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @default("") @db.VarChar(120)
  email          String          @unique @db.VarChar(320)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  status         UserStatus      @default(INVITED)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(64)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_resets")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

model Member {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(120)
  email        String?       @db.VarChar(320)
  phone        String?       @db.VarChar(32)
  status       MemberStatus  @default(ACTIVE)
  birthDate    DateTime?     @map("birth_date") @db.Date
  notes        String?       @db.VarChar(2000)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  loans        Loan[]
  reservations Reservation[]

  @@index([status, name])
  @@map("members")
}

enum CopyStatus {
  AVAILABLE
  LOANED
  RESERVED
  MAINTENANCE
  LOST
  DISPOSED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
  CANCELLED
}

enum ReservationStatus {
  WAITING
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

enum FineStatus {
  OPEN
  PAID
  FORGIVEN
  CANCELLED
}

model Book {
  id           String        @id @default(uuid()) @db.Uuid
  title        String        @db.VarChar(200)
  subtitle     String?       @db.VarChar(200)
  author       String        @db.VarChar(200)
  isbn         String?       @unique @db.VarChar(32)
  publisher    String?       @db.VarChar(200)
  edition      String?       @db.VarChar(80)
  year         Int?
  language     String        @default("pt") @db.VarChar(80)
  description  String?       @db.Text
  pages        Int?
  cover        String?       @db.VarChar(2000)
  category     String?       @db.VarChar(120)
  keywords     String[]      @default([])
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  copies       BookCopy[]
  reservations Reservation[]

  @@index([category, title])
  @@map("library_books")
}

model BookCopy {
  id           String        @id @default(uuid()) @db.Uuid
  bookId       String        @db.Uuid
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Restrict)
  assetCode    String        @unique @db.VarChar(100)
  barcode      String?       @unique @db.VarChar(100)
  qrCode       String?       @unique @db.VarChar(200)
  condition    String        @default("GOOD") @db.VarChar(120)
  location     String        @db.VarChar(200)
  status       CopyStatus    @default(AVAILABLE)
  acquiredAt   DateTime?     @db.Timestamptz(6)
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  loans        Loan[]
  reservations Reservation[]

  @@index([bookId, status])
  @@map("library_copies")
}

model Loan {
  id           String     @id @default(uuid()) @db.Uuid
  memberId     String     @db.Uuid
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  bookCopyId   String     @db.Uuid
  bookCopy     BookCopy   @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  borrowedAt   DateTime   @default(now()) @db.Timestamptz(6)
  dueAt        DateTime   @db.Timestamptz(6)
  returnedAt   DateTime?  @db.Timestamptz(6)
  status       LoanStatus @default(ACTIVE)
  renewedCount Int        @default(0)
  createdBy    String     @db.Uuid
  returnedBy   String?    @db.Uuid
  observations String?    @db.Text
  graceDays    Int
  dailyFine    Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  fine         Fine?

  @@index([memberId, status])
  @@index([status, dueAt])
  @@map("library_loans")
}

model LibrarySettings {
  id              Int      @id @default(1)
  defaultLoanDays Int      @default(14)
  maxBooks        Int      @default(3)
  maxRenewals     Int      @default(2)
  graceDays       Int      @default(0)
  dailyFine       Decimal  @default(1) @db.Decimal(12, 2)
  blockOverdue    Boolean  @default(true)
  holdDays        Int      @default(2)
  reservationDays Int      @default(30)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  @@map("library_settings")
}

model Fine {
  id          String           @id @default(uuid()) @db.Uuid
  loanId      String           @unique @db.Uuid
  loan        Loan             @relation(fields: [loanId], references: [id], onDelete: Restrict)
  amount      Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  status      FineStatus       @default(OPEN)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  payments    FinePayment[]
  adjustments FineAdjustment[]

  @@map("library_fines")
}

model FinePayment {
  id             String   @id @default(uuid()) @db.Uuid
  fineId         String   @db.Uuid
  fine           Fine     @relation(fields: [fineId], references: [id], onDelete: Restrict)
  amount         Decimal  @db.Decimal(12, 2)
  idempotencyKey String   @unique @db.Uuid
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@map("library_fine_payments")
}

model FineAdjustment {
  id            String   @id @default(uuid()) @db.Uuid
  fineId        String   @db.Uuid
  fine          Fine     @relation(fields: [fineId], references: [id], onDelete: Restrict)
  kind          String   @db.VarChar(20)
  amount        Decimal  @db.Decimal(12, 2)
  justification String   @db.VarChar(2000)
  createdBy     String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@map("library_fine_adjustments")
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  bookId     String            @db.Uuid
  book       Book              @relation(fields: [bookId], references: [id], onDelete: Restrict)
  memberId   String            @db.Uuid
  member     Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  bookCopyId String?           @db.Uuid
  bookCopy   BookCopy?         @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  status     ReservationStatus @default(WAITING)
  expiresAt  DateTime          @db.Timestamptz(6)
  readyAt    DateTime?         @db.Timestamptz(6)
  holdUntil  DateTime?         @db.Timestamptz(6)
  createdBy  String            @db.Uuid
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)

  @@index([bookId, status, createdAt])
  @@map("library_reservations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
