+const { app, BrowserWindow, session } = require("electron"),
+  fs = require("node:fs"),
+  path = require("node:path"),
+  assert = require("node:assert/strict"),
+  { WebSocket } = require("ws");
+const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+app.commandLine.appendSwitch("use-fake-device-for-media-stream");
+app.commandLine.appendSwitch("use-fake-ui-for-media-stream");
+const output = process.argv[2]
+  ? path.resolve(process.argv[2])
+  : app.getPath("temp");
+app.whenReady().then(async () => {
+  let server, timer;
+  const windows = [],
+    bridges = [],
+    errors = [];
+  try {
+    session.defaultSession.setPermissionRequestHandler(
+      (_contents, _permission, callback) => callback(true),
+    );
+    class Bridge {
+      constructor(emit) {
+        this.emit = emit;
+        this.inputs = 0;
+        bridges.push(this);
+      }
+      start(key, id) {
+        assert.equal(key, "synthetic-smoke-key");
+        this.id = id;
+        this.live = true;
+        this.emit({ ready: true });
+      }
+      stop() {
+        this.live = false;
+      }
+      audio() {
+        this.inputs++;
+      }
+    }
+    server = require("./server.cjs").createTranslationServer({
+      port: 0,
+      host: "127.0.0.1",
+      Bridge,
+    });
+    const info = await server.listen(),
+      origin = new URL(info.presenterUrl).origin;
+    const pcm = Buffer.alloc(9600);
+    for (let i = 0; i < 4800; i++)
+      pcm.writeInt16LE(
+        Math.round(5000 * Math.sin((2 * Math.PI * 440 * i) / 24000)),
+        i * 2,
+      );
+    const words = {
+      en: "Hello everyone. ",
+      es: "Hola a todos. ",
+      fr: "Bonjour à tous. ",
+    };
+    timer = setInterval(() => {
+      for (const bridge of bridges)
+        if (bridge.live)
+          bridge.emit({
+            content: {
+              outputTranscription: { text: words[bridge.id] || bridge.id },
+              modelTurn: {
+                parts: [
+                  {
+                    inlineData: {
+                      data: pcm.toString("base64"),
+                      mimeType: "audio/pcm;rate=24000",
+                    },
+                  },
+                ],
+              },
+            },
+          });
+    }, 200);
+    async function window(url, width) {
+      const win = new BrowserWindow({
+        show: false,
+        width,
+        height: 1100,
+        webPreferences: { sandbox: true, backgroundThrottling: false },
+      });
+      windows.push(win);
+      win.webContents.on("console-message", (_event, ...args) => {
+        if (
+          args.some(
+            (value) => typeof value === "string" && value.includes("Uncaught"),
+          )
+        )
+          errors.push(args);
+      });
+      await win.loadURL(url);
+      return win;
+    }
+    const run = (win, code) => win.webContents.executeJavaScript(code, true);
+    async function until(win, code) {
+      for (let i = 0; i < 100; i++) {
+        if (await run(win, code)) return;
+        await wait(100);
+      }
+      throw Error("Timed out: " + code);
+    }
+    const host = await window(info.presenterUrl, 1000);
+    await until(
+      host,
+      "document.querySelectorAll('#channel-list [role=listitem]').length===1",
+    );
+    await run(
+      host,
+      "document.querySelector('[aria-label=\"Fechar canal Inglês\"]').click()",
+    );
