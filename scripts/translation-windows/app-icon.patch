new file mode 100644
--- /dev/null
+++ b/set-app-icon.cjs
@@ -0,0 +1,4 @@
+(async () => {
+  const { rcedit } = await import('rcedit');
+  await rcedit(process.argv[2], { icon: process.argv[3] });
+})().catch(error => { console.error(error.message); process.exitCode = 1; });
