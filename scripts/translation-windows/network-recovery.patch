diff --git a/diagnostics.cjs b/diagnostics.cjs
new file mode 100644
index 0000000..e285558
--- /dev/null
+++ b/diagnostics.cjs
@@ -0,0 +1,16 @@
+const fs = require('node:fs');
+const path = require('node:path');
+
+// Callers supply fixed event names, language IDs and numeric metadata only.
+function createDiagnostics(directory) {
+  const file = path.join(directory, 'traducao.txt');
+  return (event, fields = {}) => {
+    try {
+      fs.mkdirSync(directory, { recursive: true });
+      if ((fs.statSync(file, { throwIfNoEntry: false })?.size || 0) >= 1024 * 1024)
+        fs.renameSync(file, file + '.1');
+      fs.appendFileSync(file, JSON.stringify({ time: new Date().toISOString(), event, ...fields }) + '\n');
+    } catch { /* A storage failure must not interrupt capture. */ }
+  };
+}
+module.exports = { createDiagnostics };
