{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "cd ../.. && npm run build --workspace @church/shared && npm run db:generate && npm run build --workspace @church/api",
      "functions": {
        "src/main.ts": {
          "maxDuration": 180,
          "includeFiles": "{src/modules/banking/efatura/*.cjs,{node_modules,../../node_modules}/{@puppeteer/browsers,@sparticuz/chromium,ansi-regex,ansi-styles,b4a,bare-events,bare-fs,bare-path,bare-stream,bare-url,chromium-bidi,cliui,devtools-protocol,emoji-regex,end-of-stream,escalade,events-universal,fast-fifo,get-caller-file,get-east-asian-width,mitt,modern-tar,once,pump,puppeteer-core,streamx,string-width,strip-ansi,tar-fs,tar-stream,teex,text-decoder,typed-query-selector,webdriver-bidi-protocol,wrap-ansi,wrappy,ws,y18n,yargs,yargs-parser,zod}/**}"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "cd ../.. && npm run build --workspace @church/shared && npm run build --workspace @church/web",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
